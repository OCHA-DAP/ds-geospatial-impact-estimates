# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# uv / virtualenv
.venv/

# Build artifacts (generated from uv.lock / vite at deploy time)
requirements.txt
web/dist/

# Environment / secrets
.env
.env.*
!.env.example

# Local data scratch (lake lives in Azure Blob, not git)
data/
*.duckdb
*.duckdb.wal
*.parquet
*.pmtiles
*.tif
*.tiff

# Notebooks
.ipynb_checkpoints/

# Generated exploratory figures — regenerate by running the analysis; never commit
figs/

# OS / editor
.DS_Store
.idea/
.vscode/

# Local-only notes (decide later where/whether to commit)
docs/deployment.md

# Paper workspace: track source (scripts, qmd, notes, frozen CSVs); ignore rendered
# HTML (multi-MB self-contained) and call-prep material (internal). Figures are covered
# by the global figs/ rule above.
exploratory/paper/*.html
!exploratory/paper/boss_deck.html
exploratory/paper/*_files/
exploratory/paper/ms_call_*
exploratory/paper/_freeze_batch.log

# Local-only ADR (UniteApps registration internals) — deliberately not committed
docs/decisions/0024-uniteapps-registration-compliance.md
