{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "*.{css,js,map,png,svg,ico,json,woff2}"
    ]
  },
  "routes": [
    {
      "route": "/form-spike/provider.html",
      "allowedRoles": [
        "provider"
      ]
    },
    {
      "route": "/form-spike/gated.html",
      "allowedRoles": [
        "authenticated"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad?post_login_redirect_uri=.referrer",
      "statusCode": 302
    },
    "403": {
      "redirect": "/form-spike/providers.html?forbidden=1",
      "statusCode": 302
    }
  },
  "platform": {
    "apiRuntime": "node:18"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
