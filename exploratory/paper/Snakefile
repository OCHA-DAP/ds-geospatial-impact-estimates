# ---------------------------------------------------------------- number diff against any git ref
rule diff:
    # usage: snakemake diff --config base=origin/v1   -> artefacts/_audit/diff_<base>.md
    input: f"{A}/results.csv", f"{A}/diff_results.py"
    params: base=config.get("base", "origin/v1")
    output: touch(f"{A}/_audit/diff.done")
    shell: f"cd {A} && {PY} diff_results.py --base {{params.base}}"
