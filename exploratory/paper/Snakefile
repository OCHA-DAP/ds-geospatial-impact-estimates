# Paper analysis DAG (ADR-0032). Run from the repo root:
#
#   uv run --group etl --group paper snakemake -s exploratory/paper/Snakefile -d exploratory/paper -n      # what is stale
#   uv run --group etl --group paper snakemake -s exploratory/paper/Snakefile -d exploratory/paper -c2     # build the brief
#   ... diff --config base=origin/v1                                                                        # every changed number vs a git ref
#   ... --touch   after verifying a checked-out state whose mtimes are not trustworthy
#
# Shape: three compact modules (scorecards, ranking, facts) compute rows of ONE results table
# from the shared library; a few adapters wrap the frozen heavy chain (fusion, bootstrap,
# ablation, round-2 crowd) and the appendix-only diagnostics that were not migrated; the brief
# reads only results.csv. Heavy rules do not depend on the library and rerun only when named.

A = "artefacts"
P = "pipeline"
LIB = [f"{P}/paperlib.py", f"{A}/lib/gie_paper.py"]


def art(script, *args, env=""):
    return f"cd {A} && {env} python {script} {' '.join(args)}"


# ---------------------------------------------------------------- final targets
rule all:
    input: "manuscript_brief.html", f"{A}/_audit/brief_numbers_audit.txt", f"{P}/.tests_passed"

rule heavy:
    input:
        expand(f"{A}/RQ8-learned-fusion/rq8_best_f1_r{{r}}.csv", r=[10, 20, 30]),
        expand(f"{A}/RQ8-learned-fusion/rq8b_asdelivered_baseline_r{{r}}.csv", r=[10, 20]),
        f"{A}/RQ8-learned-fusion/rq8c_basis_pr_r10.csv", f"{A}/RQ8-learned-fusion/rq8d_null_ablation.csv",
        f"{A}/RQ9-uncertainty/rq9_ci_core.csv",

# ---------------------------------------------------------------- the compact pipeline
rule scorecards:
    input: LIB, f"{P}/scorecards.py"
    output: f"{P}/results_scorecards.csv"
    shell: f"python {P}/scorecards.py"

rule ranking:
    input: LIB, f"{P}/ranking.py"
    output: f"{P}/results_ranking.csv"
    shell: f"python {P}/ranking.py --with-fusion"

rule facts:
    input: LIB, f"{P}/facts.py"
    output: f"{P}/results_facts.csv"
    shell: f"python {P}/facts.py"

rule pipeline_tests:
    input: LIB, f"{P}/tests/test_paperlib.py", f"{P}/tests/test_results_invariants.py", f"{A}/results.csv"
    output: touch(f"{P}/.tests_passed")
    shell: f"pytest {P}/tests -q"

rule oracle_check:
    # the compact modules must reproduce the frozen scripts' numbers (explained exceptions listed in the script)
    input: f"{P}/check_against_oracle.py", f"{P}/results_scorecards.csv", f"{P}/results_ranking.csv", f"{A}/results_oracle_frozen.csv"
    output: touch(f"{P}/.oracle_checked")
    shell: f"python {P}/check_against_oracle.py {P}/results_scorecards.csv {P}/results_ranking.csv"

# ---------------------------------------------------------------- frozen heavy chain (appendix; explicit reruns only, no LIB dependency)
rule rq8:
    input: f"{A}/RQ8-learned-fusion/scripts/rq8_learned_fusion.py"
    output: f"{A}/RQ8-learned-fusion/rq8_best_f1_r{{r}}.csv", f"{A}/RQ8-learned-fusion/rq8_summary_r{{r}}.csv"
    wildcard_constraints: r="10|20|30"
    shell: art("RQ8-learned-fusion/scripts/rq8_learned_fusion.py", env="GIE_LABEL_R={wildcards.r} GIE_DUMP_OOF=1")

rule rq8b:
    input: f"{A}/RQ8-learned-fusion/scripts/rq8b_asdelivered_baseline.py"
    output: f"{A}/RQ8-learned-fusion/rq8b_asdelivered_baseline_r{{r}}.csv"
    wildcard_constraints: r="10|20|30"
    shell: art("RQ8-learned-fusion/scripts/rq8b_asdelivered_baseline.py", env="GIE_LABEL_R={wildcards.r}")

rule rq8c:
    input: f"{A}/RQ8-learned-fusion/scripts/rq8c_basis_sensitivity.py", f"{A}/RQ8-learned-fusion/rq8_best_f1_r10.csv"
    output: f"{A}/RQ8-learned-fusion/rq8c_basis_pr_r10.csv"
    shell: art("RQ8-learned-fusion/scripts/rq8c_basis_sensitivity.py")

rule rq8d:
    input: f"{A}/RQ8-learned-fusion/scripts/rq8d_null_ablation.py", f"{A}/RQ3-prioritization-error-structure/rq3f_null_ranking_core.csv"
    output: f"{A}/RQ8-learned-fusion/rq8d_null_ablation.csv"
    shell: art("RQ8-learned-fusion/scripts/rq8d_null_ablation.py", "--with-soil")

rule rq9:
    input: f"{A}/RQ9-uncertainty/scripts/rq9_block_bootstrap.py", f"{A}/RQ5-ensemble/rq5b_six_member.csv", f"{A}/RQ2-cems-footprint-points/rq2i_per_aoi_scorecard.csv"
    output: f"{A}/RQ9-uncertainty/rq9_ci_core.csv", f"{A}/RQ9-uncertainty/rq9_ci_asdelivered_r10.csv", f"{A}/RQ9-uncertainty/rq9_ci_models_r10.csv"
    shell: art("RQ9-uncertainty/scripts/rq9_block_bootstrap.py")

# ---------------------------------------------------------------- appendix-only diagnostics still produced by their frozen scripts
rule rq7_round2:
    input: LIB[1], f"{A}/RQ7-mapswipe-validation/scripts/rq7_round2_replication.py", f"{A}/RQ2-cems-footprint-points/rq2i_per_aoi_scorecard.csv"
    output: f"{A}/RQ7-mapswipe-validation/rq7_round2_replication.csv", f"{A}/RQ7-mapswipe-validation/rq7_round2_padj_sensitivity.csv"
    shell: art("RQ7-mapswipe-validation/scripts/rq7_round2_replication.py")

rule rq2h:
    input: LIB[1], f"{A}/RQ2-cems-footprint-points/scripts/rq2h_osu_v0_v1.py"
    output: f"{A}/RQ2-cems-footprint-points/rq2h_osu_v0_v1.csv"
    shell: art("RQ2-cems-footprint-points/scripts/rq2h_osu_v0_v1.py")

rule rq2p:
    input: LIB[1], f"{A}/RQ2-cems-footprint-points/scripts/rq2p_osu_v1_tiers.py"
    output: f"{A}/RQ2-cems-footprint-points/rq2p_osu_v1_tiers.csv"
    shell: art("RQ2-cems-footprint-points/scripts/rq2p_osu_v1_tiers.py")

rule rq2_density_null:
    input: LIB[1], f"{A}/RQ2-cems-footprint-points/scripts/rq2_density_null.py"
    output: f"{A}/RQ2-cems-footprint-points/rq2_density_null.csv"
    shell: art("RQ2-cems-footprint-points/scripts/rq2_density_null.py")

rule rq3g:
    input: LIB[1], f"{A}/RQ3-prioritization-error-structure/scripts/rq3g_frac_ranking.py", f"{A}/RQ3-prioritization-error-structure/rq3f_null_ranking.csv"
    output: f"{A}/RQ3-prioritization-error-structure/rq3g_frac_vs_count.csv", f"{A}/RQ3-prioritization-error-structure/figs/rq3g_frac_vs_count_rho.png"
    shell: art("RQ3-prioritization-error-structure/scripts/rq3g_frac_ranking.py")

rule rq3b:
    input: LIB[1], f"{A}/RQ3-prioritization-error-structure/scripts/rq3b_per_area_moran.py"
    output: f"{A}/RQ3-prioritization-error-structure/rq3b_per_area_moran.csv"
    shell: art("RQ3-prioritization-error-structure/scripts/rq3b_per_area_moran.py")

rule rq3d:
    input: LIB[1], f"{A}/RQ3-prioritization-error-structure/scripts/rq3d_lisa_reliability.py"
    output: f"{A}/RQ3-prioritization-error-structure/rq3d_lisa_summary.csv"
    shell: art("RQ3-prioritization-error-structure/scripts/rq3d_lisa_reliability.py")

# ---------------------------------------------------------------- one results table
FROZEN_INPUTS = [
    f"{A}/RQ2-cems-footprint-points/rq2h_osu_v0_v1.csv", f"{A}/RQ2-cems-footprint-points/rq2p_osu_v1_tiers.csv",
    f"{A}/RQ2-cems-footprint-points/rq2_density_null.csv", f"{A}/RQ2-cems-footprint-points/rq2_ms_confidence_curve.csv",
    f"{A}/RQ3-prioritization-error-structure/rq3g_frac_vs_count.csv", f"{A}/RQ3-prioritization-error-structure/rq3b_per_area_moran.csv",
    f"{A}/RQ3-prioritization-error-structure/rq3d_lisa_summary.csv",
    expand(f"{A}/RQ8-learned-fusion/rq8_best_f1_r{{r}}.csv", r=[10, 20, 30]), expand(f"{A}/RQ8-learned-fusion/rq8b_asdelivered_baseline_r{{r}}.csv", r=[10, 20]),
    f"{A}/RQ9-uncertainty/rq9_ci_core.csv", f"{A}/RQ9-uncertainty/rq9_ci_asdelivered_r10.csv", f"{A}/RQ9-uncertainty/rq9_ci_models_r10.csv",
    f"{A}/RQ8-learned-fusion/rq8c_basis_pr_r10.csv",
    f"{A}/RQ7-mapswipe-validation/rq7_round2_padj_sensitivity.csv", f"{A}/RQ7-mapswipe-validation/rq7_round2_replication.csv",
    f"{A}/RQ0-matching-basis/native_rerun/shared_base_polygon_core.csv",
]

rule results:
    input: f"{P}/results_scorecards.csv", f"{P}/results_ranking.csv", f"{P}/results_facts.csv", FROZEN_INPUTS, f"{A}/consolidate.py"
    output: f"{A}/results.csv"
    shell: f"cd {A} && python consolidate.py"

# ---------------------------------------------------------------- figures (drawn from CSVs or static; the frozen fig scripts stay in place)
FIG_RULES = {
    # output png : (script, inputs..., args)
    f"{A}/RQ2-cems-footprint-points/figs/rq2e_grade_slope.png": ("RQ2-cems-footprint-points/scripts/rq2e_grade_slope_fig.py", [f"{A}/RQ2-cems-footprint-points/rq2_chatmap_recall.csv"], ""),
    f"{A}/RQ2-cems-footprint-points/figs/rq2r_bounds_ladder.png": ("RQ2-cems-footprint-points/scripts/rq2r_bounds_fig.py", [f"{A}/RQ2-cems-footprint-points/rq2r_precision_bounds.csv"], ""),
