# Paper analysis DAG (ADR-0032). Run from the repo root:
#
#   uv run --group etl --group paper snakemake -s exploratory/paper/Snakefile -d exploratory/paper -n     # what is stale
#   uv run --group etl --group paper snakemake -s exploratory/paper/Snakefile -d exploratory/paper -c2    # build the brief
#   ... --touch   after verifying a checked-out state whose mtimes are not trustworthy
#
# Every rule's outputs are the CSVs and figures its script writes. `LIB` is an input of every
# migrated rule, so a change to a shared definition marks every dependent number stale.
# HEAVY rules (fusion, bootstrap, ablation) feed the appendix only; they do not depend on LIB
# and rerun only when named explicitly (`snakemake heavy`), so an edit to the library never
# costs an hour of compute unless you ask for it. Their current outputs are in the ADR-0030/0031
# frame (re-run 2026-09-10).

import os

A = "artefacts"
LIB = f"{A}/lib/gie_paper.py"
PY = "python"  # the snakemake process already runs inside `uv run --group etl --group paper`
CORE_FLAGS = ["MS", "IMPACT", "OSU", "UH", "LIST", "UNEP"]


def run(script, *args, env=""):
    return f"cd {A} && {env} {PY} {script} {' '.join(args)}"


# ---------------------------------------------------------------- final targets
rule all:
    input: "manuscript_brief.html", f"{A}/_audit/brief_numbers_audit.txt"

rule heavy:
    input:
        expand(f"{A}/RQ8-learned-fusion/rq8_best_f1_r{{r}}.csv", r=[10, 20, 30]),
        expand(f"{A}/RQ8-learned-fusion/rq8b_asdelivered_baseline_r{{r}}.csv", r=[10, 20, 30]),
        f"{A}/RQ8-learned-fusion/rq8c_basis_pr_r10.csv",
        f"{A}/RQ8-learned-fusion/rq8d_null_ablation.csv",
        f"{A}/RQ9-uncertainty/rq9_ci_core.csv",

