# Copy to .env and fill in. Never commit .env.
#
# Reuse the team SAS tokens (same ones ocha-stratus uses). Set the ones you
# have for the stage you work against; write tokens are needed for ETL uploads.
DSCI_AZ_BLOB_DEV_SAS=
DSCI_AZ_BLOB_DEV_SAS_WRITE=
DSCI_AZ_BLOB_PROD_SAS=
DSCI_AZ_BLOB_PROD_SAS_WRITE=

# Optional overrides (defaults shown).
GIE_STAGE=dev
GIE_CONTAINER=projects
GIE_PROJECT_PREFIX=ds-geospatial-impact-estimates
